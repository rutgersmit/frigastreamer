<?xml version="1.0" encoding="utf-8"?>
<!--
  Frigate uses HTTP (port 5000) and RTSP on the LAN. Android cannot restrict cleartext to
  IP ranges (domain-config only accepts hostnames), so cleartext is enabled app-wide.
  The app only connects to the configured Frigate host and manually entered camera URLs;
  there is no other network traffic.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
